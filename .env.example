# ---------------------------------------------------------------------------
# Modellanbieter. Der Agent im Container liest diese Variablen aus der
# Umgebung, NICHT aus config/openclaw.json — siehe Spec §7 "Secrets".
#
# Bis ein eigener, guthabengedeckter Schluessel existiert, laeuft der
# Rauchtest ueber OpenRouters kostenlose Modelle.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# OPENAI_BASE_URL wird bewusst NICHT gesetzt. Ein lokal laufendes Modell ist
# fuer dieses Projekt ausgeschlossen — die Maschine traegt es nicht. Zeigt
# diese Variable je auf einen lokalen Endpunkt, ist das ein Fehler, keine
# Option. OpenRouter braucht sie nicht: OpenClaw hat einen eigenen Provider.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Zeitzone des Containers. Termin- und Digest-Logik späterer Stufen hängt daran.
# ---------------------------------------------------------------------------
TZ=Europe/Berlin

# ---------------------------------------------------------------------------
# Versand über OpenWA (Stufe 3). Gelesen von sales-mcp/dispatch.py.
#
# OPENWA_API_KEY erzeugt OpenWA beim allerersten Boot selbst und schreibt ihn
# nach /app/data/.api-key (Volume openwa-data) sowie einmalig ins Startup-Log
# — er wird NICHT hier gesetzt, sondern von dort in die echte .env übernommen
# (Weg dokumentiert im T1-Bericht).
#
# OPENWA_SESSION_ID ist die ID der OpenWA-Session "sales" (kein Geheimnis) —
# abrufbar über GET /api/sessions.
#
# OPENWA_URL setzt docker-compose.yml für den Dienst sales-dispatch fest auf
# http://openwa:2785 (gemeinsames Compose-Netz); hier nur zur Orientierung.
# ---------------------------------------------------------------------------
OPENWA_API_KEY=
OPENWA_SESSION_ID=00000000-0000-0000-0000-000000000000
# OPENWA_URL=http://openwa:2785
# OPENWA_TIMEOUT_S=30      # HTTP-Timeout je Sendeversuch
# DISPATCH_INTERVAL_S=10   # Sekunden zwischen zwei Runden
# DISPATCH_ONCE=1          # eine Runde, dann Exit 0 (Demo/Einzeltest)

# ---------------------------------------------------------------------------
# Eingehende Kundenantworten (Stufe 4, F1). Gelesen von sales-mcp/inbox.py
# (Dienst sales-inbox).
#
# INBOX_WEBHOOK_SECRET ist das HMAC-Geheimnis, mit dem OpenWA jeden Webhook
# signiert (`X-OpenWA-Signature: sha256=<hex>` ueber den rohen Rumpf). Es wird
# lokal mit einem CSPRNG erzeugt und bei der Webhook-Registrierung an OpenWA
# uebergeben — NIE ausgeben, nie ins Repo. Mindestens 16 Zeichen (OpenWA
# erzwingt dieselbe Untergrenze); ohne gesetzten Wert startet sales-inbox
# nicht. Wird es gewechselt, muss auch der registrierte Webhook aktualisiert
# werden (PUT /api/sessions/{id}/webhooks/{webhookId}), sonst kommt nichts
# mehr an.
#
# INBOX_UNBEKANNT_LEAD_ID ist der Sammel-Lead „Unbekannte Eingaenge" — dort
# landen Nachrichten von Nummern, die im CRM nicht stehen. Unbekannte
# Absender werden bewusst NICHT automatisch als Kontakt angelegt
# (Spam-Schutz). Einmalig ueber `kontakt_anlegen` erzeugen und die lead_id
# hier eintragen; ohne Wert startet sales-inbox nicht.
# ---------------------------------------------------------------------------
INBOX_WEBHOOK_SECRET=
INBOX_UNBEKANNT_LEAD_ID=00000000-0000-0000-0000-000000000000
# INBOX_PORT=8790          # Port im Compose-Netz (kein Host-Port!)

# ---------------------------------------------------------------------------
# Recherche über Apify (Stufe 5). Gelesen von sales-mcp/recherche.py
# (Werkzeuge marktanalyse und b2b_leads im Dienst sales-mcp).
#
# APIFY_TOKEN ist der persönliche API-Token des Apify-Kontos
# (console.apify.com -> Settings -> API & Integrations). Er ist ein
# Geheimnis: er reist als Query-Parameter an die Apify-API (deren Konvention)
# und darf nie in ein Log, einen Chat oder eine Fehlermeldung geraten —
# recherche.py filtert ihn deshalb aus fremden Fehlerrümpfen heraus. Fehlt er,
# antworten beide Werkzeuge mit einem Fehlertext, OHNE eine Anfrage zu stellen.
#
# ACHTUNG BUDGET: der Free-Plan hat $5 Guthaben im Monat. Der verwendete Actor
# (compass/crawler-google-places) rechnet pro Ereignis ab — gemessen $0.00005
# je Lauf plus $0.004 je Treffer. Ein Aufruf mit dem Höchstwert (limit 50)
# kostet also rund $0.20. Ist das Guthaben leer, antwortet Apify mit 4xx und
# das Werkzeug nennt genau das als Grund.
#
# RECHERCHE_LEAD_ID ist der Sammelkontakt „RECHERCHE (Sammelkontakt)": dort
# hängen die activities vom Typ `recherche` (Suchparameter, Trefferzahlen,
# Reportpfad) — dasselbe Muster wie INBOX_UNBEKANNT_LEAD_ID. Einmalig über
# `kontakt_anlegen` erzeugen und die lead_id hier eintragen. Fehlt sie, laufen
# die Werkzeuge trotzdem, melden aber „nicht protokolliert" zurück.
# ---------------------------------------------------------------------------
APIFY_TOKEN=
RECHERCHE_LEAD_ID=00000000-0000-0000-0000-000000000000
# Sammelkontakt "LINKEDIN (Eigenes Profil)" für Post-Entwürfe (Stufe 6) —
# gleiches Muster: einmalig als Lead (source='system') anlegen, UUID hier rein.
LINKEDIN_POST_LEAD_ID=00000000-0000-0000-0000-000000000000
# REPORT_DIR=/reports              # Ziel der Markdown-Reports (Bind ./reports)
#   Seit Stufe 9 liegen hier auch die Kalenderdateien (.ics) von
#   termin_bestaetigen.
# APIFY_TIMEOUT_S=180              # HTTP-Timeout je Recherche-Lauf
# APIFY_LAUF_TIMEOUT_S=120         # Laufzeitdeckel für den Actor selbst.
#   MUSS unter APIFY_TIMEOUT_S liegen (sonst: Lauf läuft bei Apify weiter und
#   kostet, während wir schon aufgelegt haben — „bezahlt, nichts bekommen").
#   recherche.py erzwingt die Ordnung inzwischen selbst (kappt auf
#   HTTP-Timeout minus 30 s), aber die Empfehlung hier soll nicht das
#   Gegenteil der Konstruktion vorschlagen.

# ---------------------------------------------------------------------------
# E-Mail-Versand (Stufe 9, G2). Gelesen von sales-mcp/mail_dispatch.py
# (Dienst sales-mail).
#
# Der Dienst ist der Zwilling des WhatsApp-Dispatchers: er liest
# ausschliesslich drafts(status='approved', channel='email'). Ohne die vier
# Pflichtwerte beendet er sich beim Start mit einer klaren Logzeile und
# Exit 0 — der Kanal ist dann gebaut, aber inert, und freigegebene
# E-Mail-Entwürfe bleiben unangetastet liegen.
#
# SMTP_PASSWORT ist ein Geheimnis: NIE ausgeben, nie ins Repo, nie in ein Log.
# mail_dispatch.py filtert es aus fremden Antworttexten heraus (SMTP-Server
# spiegeln die Anfrage manchmal zurück), so wie recherche.py es mit dem
# Apify-Token tut. Es reist ausschliesslich über die TLS-Verbindung, nie in
# argv.
#
# SMTP_PORT entscheidet über die Verschlüsselung — das ist keine Einstellung,
# sondern der Unterschied zweier Protokolle:
#   465 -> implizites TLS (SMTP_SSL, ab dem ersten Byte verschlüsselt)
#   587 -> STARTTLS auf einer zunächst blanken Verbindung
# Einen unverschlüsselten Weg gibt es nicht.
#
# BETREIBER-AKTION, niemals selbst Zugangsdaten erfinden. Bekannte Werte:
#   Namecheap PrivateEmail: mail.privateemail.com:465 (App-Passwort im
#     Kundenportal erzeugen)
#   GMX:                    mail.gmx.net:587 (Versand über externe Programme
#     muss im Postfach erst freigeschaltet werden)
#
# EMAIL_ABSENDER ist die Adresse, die beim Empfänger als Absender steht. Sie
# muss zum Postfach von SMTP_USER passen — sonst weisen viele Server die Mail
# ab (SPF/DMARC).
#
# KEINE ANHÄNGE: dieser Dienst versendet reinen Text. Ein E-Mail-Entwurf mit
# `media_ref` wird ausdrücklich fehlgeschlagen gebucht, statt ohne die
# Unterlage rauszugehen — freigegeben wurde eine Nachricht MIT Unterlage.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORT=
EMAIL_ABSENDER=
# SMTP_TIMEOUT_S=30        # Zeitlimit je Zustellversuch
# MAIL_INTERVAL_S=10       # Sekunden zwischen zwei Runden (Compose setzt es)
# MAIL_SENDE_PAUSE_S=1.0   # Pause zwischen zwei tatsächlichen Sendungen
# MAIL_ONCE=1              # eine Runde, dann Exit 0 (Demo/Einzeltest)

# ---------------------------------------------------------------------------
# Kalender-Eintrag über CalDAV (Stufe 9, G1b). Gelesen von
# sales-mcp/kalender.py (Werkzeug termin_bestaetigen im Dienst sales-mcp).
#
# OPTIONAL. Fehlt einer der drei Werte, erzeugt `termin_bestaetigen` nur die
# ICS-Datei unter /reports und sagt es im Hinweis — kein Fehler, keine
# Überraschung. Der Kalendereintrag ist Selbstorganisation des Betreibers und
# hat mit dem Freigabe-Gate nichts zu tun: er berührt weder `drafts` noch
# irgendeine Kundenkommunikation.
#
# CALDAV_URL muss auf eine Kalender-KOLLEKTION zeigen, nicht auf die Wurzel
# des Servers — also auf die Adresse, die das Panel des Anbieters für
# Thunderbird/CalDAV nennt, in der Form
# https://<host>/dav.php/calendars/<benutzer>/<kalender>/
#
# Die richtige Kollektions-URL findet man per PROPFIND mit Depth 1 auf
# /dav.php/calendars/<benutzer>/ — maßgeblich ist der Eintrag, dessen
# `resourcetype` ein `calendar` enthält, nicht die Sammel-URL darüber.
#
# GEMESSEN (2026-08-19, Namecheap PrivateEmail): der Server steht hinter
# einer WAF, die Anfragen mit der VORGABE-Kennung von urllib
# (`Python-urllib/3.12`) pauschal mit HTTP 403 beantwortet — unabhängig von
# den Zugangsdaten. Jede eigene Kennung wird korrekt beantwortet (207).
# kalender.py sendet deshalb fest die sprechende Kennung des Hauses;
# CALDAV_USER_AGENT stellt sie um, falls ein anderer Anbieter etwas anderes
# verlangt. Das App-Passwort deckt DAV, es ist dasselbe wie für SMTP.
#
# CALDAV_PASSWORT ist ein Geheimnis (siehe SMTP_PASSWORT). Es reist im
# Authorization-Header, nie in argv und nie in der URL.
# ---------------------------------------------------------------------------
# CALDAV_URL=https://dav.privateemail.com/dav.php/calendars/<benutzer>/<kalender>/
# CALDAV_USER=
# CALDAV_PASSWORT=
# CALDAV_TIMEOUT_S=20
# CALDAV_USER_AGENT=              # Vorgabe: "Mozilla/5.0 (compatible;
#   sales-claw/1.0; CalDAV)" — die sprechende Kennung des Hauses, KEINE
#   Fremdprodukt-Imitation (gemessen reicht jede eigene Kennung, siehe oben)
