# ---------------------------------------------------------------------------
# Modellanbieter. Der Agent im Container liest diese Variablen aus der
# Umgebung, NICHT aus config/openclaw.json — siehe Spec §7 "Secrets".
#
# Bis ein eigener, guthabengedeckter Schluessel existiert, laeuft der
# Rauchtest ueber OpenRouters kostenlose Modelle.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# OPENAI_BASE_URL wird bewusst NICHT gesetzt. Ein lokal laufendes Modell ist
# fuer dieses Projekt ausgeschlossen — die Maschine traegt es nicht. Zeigt
# diese Variable je auf einen lokalen Endpunkt, ist das ein Fehler, keine
# Option. OpenRouter braucht sie nicht: OpenClaw hat einen eigenen Provider.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Zeitzone des Containers. Termin- und Digest-Logik späterer Stufen hängt daran.
# ---------------------------------------------------------------------------
TZ=Europe/Berlin

# ---------------------------------------------------------------------------
# Versand über OpenWA (Stufe 3). Gelesen von sales-mcp/dispatch.py.
#
# OPENWA_API_KEY erzeugt OpenWA beim allerersten Boot selbst und schreibt ihn
# nach /app/data/.api-key (Volume openwa-data) sowie einmalig ins Startup-Log
# — er wird NICHT hier gesetzt, sondern von dort in die echte .env übernommen
# (Weg dokumentiert im T1-Bericht).
#
# OPENWA_SESSION_ID ist die ID der OpenWA-Session "sales" (kein Geheimnis) —
# abrufbar über GET /api/sessions.
#
# OPENWA_URL setzt docker-compose.yml für den Dienst sales-dispatch fest auf
# http://openwa:2785 (gemeinsames Compose-Netz); hier nur zur Orientierung.
# ---------------------------------------------------------------------------
OPENWA_API_KEY=
OPENWA_SESSION_ID=00000000-0000-0000-0000-000000000000
# OPENWA_URL=http://openwa:2785
# OPENWA_TIMEOUT_S=30      # HTTP-Timeout je Sendeversuch
# DISPATCH_INTERVAL_S=10   # Sekunden zwischen zwei Runden
# DISPATCH_ONCE=1          # eine Runde, dann Exit 0 (Demo/Einzeltest)
