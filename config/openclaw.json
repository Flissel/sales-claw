{
  "gateway": {
    "port": 18894,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-sonnet-5",
        "fallbacks": [
          "openrouter/free"
        ]
      },
      "workspace": "/home/node/.openclaw/workspace",
      "_kommentar_bootstrap": "GEMESSEN 22.08.2026: AGENTS.md ist ~47000 Zeichen. Mit den Vorgaben (20000 je Datei, 60000 gesamt) wurden davon nur 19184 in den Systemprompt eingespritzt - 41 Prozent. Abgeschnitten wurde alles ab 'Kundenchats (Auto-Betrieb)', DARUNTER DER ABSCHNITT 'Verbote - ohne Ausnahme'. Der Agent kannte seine eigenen absoluten Verbote also nicht; dass er sich trotzdem regelkonform verhielt, war das Urteil des Modells und nicht diese Datei. Der Fehler ist still: OpenClaw meldet ihn nur im JSON-Bericht eines Laufs (bootstrapTruncation), nicht im Log. Wer AGENTS.md kuerzt, darf diese Werte wieder senken - wer sie waechst, muss hier nachziehen.",
      "bootstrapMaxChars": 60000,
      "bootstrapTotalMaxChars": 100000
    },
    "list": [
      {
        "id": "main"
      }
    ]
  },
  "models": {
    "providers": {
      "openrouter": {
        "models": [
          {
            "id": "openrouter/free",
            "name": "openrouter/free"
          }
        ]
      },
      "anthropic": {
        "models": [
          {
            "id": "claude-sonnet-5",
            "name": "claude-sonnet-5"
          }
        ]
      }
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "selfChatMode": true,
      "allowFrom": [
        "+491603449761",
        "+491749708452"
      ],
      "groupPolicy": "disabled",
      "mediaMaxMb": 50
    }
  },
  "plugins": {
    "allow": [
      "whatsapp"
    ],
    "slots": {
      "memory": "memory-core"
    },
    "entries": {
      "whatsapp": {
        "enabled": true
      },
      "memory-core": {
        "enabled": true
      },
      "openclaw-supermemory": {
        "enabled": false
      },
      "discord": {
        "enabled": false
      },
      "telegram": {
        "enabled": false
      },
      "voice-call": {
        "enabled": false
      },
      "browser": {
        "enabled": false
      },
      "ollama": {
        "enabled": false
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "enabled": false
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  }
}
