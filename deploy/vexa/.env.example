# Vorlage fuer deploy/vexa/.env (Vexa-Stack, Compose-Projekt "vexa").
# Die echte .env erzeugt `bash deploy/vexa-anbinden.sh` mit Zufallswerten
# (Rechte 600) — nicht von Hand kopieren, nicht committen. Die Werte hier sind
# nur Platzhalter, damit `docker compose config` ohne echte Geheimnisse laeuft.
ADMIN_TOKEN=PLATZHALTER-wird-von-vexa-anbinden-sh-erzeugt
VEXA_DB_PASSWORD=PLATZHALTER-wird-von-vexa-anbinden-sh-erzeugt
VEXA_S3_ACCESS_KEY=PLATZHALTER-wird-von-vexa-anbinden-sh-erzeugt
VEXA_S3_SECRET_KEY=PLATZHALTER-wird-von-vexa-anbinden-sh-erzeugt
# Jitsi-Hosts (Komma-Liste), in die der Bot gehen darf. Kein Geheimnis; fehlt
# die Zeile in deploy/vexa/.env, gilt meet.ffmuc.net.
VEXA_JITSI_HOSTS=meet.ffmuc.net
