# Vorlage fuer einen Laden. Kopieren nach deploy/laeden/<name>.env und
# ausfuellen. Die ausgefuellte Datei enthaelt den Datenbank-DSN samt
# Passwort und ist per .gitignore ausgeschlossen — sie gehoert NICHT ins
# Repository.
#
# Der bestehende Laden braucht KEINE solche Datei: alle Vorgabewerte in
# den Compose-Dateien loesen auf seinen bisherigen Stand auf.

LADEN_PRAEFIX=ivan
LADEN_PROJEKT=ivan-claw

# Host-Ports. Muessen sich von jedem anderen Laden unterscheiden —
# sales: 18894 / 8791 / 12785
PORT_GATEWAY=18895
PORT_UI=8792
PORT_OPENWA=12786

# Schlussfix D (16.09.2026), Punkt 6 — vorher hier gefehlt. Ohne diese
# Zeile faellt docker-compose.yml (Dienst sales-ui) auf
# "http://127.0.0.1:12785" zurueck: den OpenWA-Port des ERSTEN Ladens
# ("sales"), nicht auf PORT_OPENWA (oben, 12786) dieses Ladens. Gemessen:
# ivan-ui trug tatsaechlich 12785, bevor diese Zeile eingetragen wurde. Muss
# PORT_OPENWA aus der vorigen Zeile spiegeln — deploy/laden-anlegen.sh
# schreibt beide inzwischen automatisch zusammen fuer neu angelegte Laeden.
OPENWA_DASHBOARD_URL=http://127.0.0.1:12786

# Datenbank: eigenes Schema, eigener Benutzer (Aufgabe 3).
SALES_DB_SCHEMA=sales_ivan
SALES_DB_URL=postgresql://sales_app_ivan:PASSWORT@192.168.178.65:54322/postgres

# Die Tailscale-Adresse dieses Rechners, damit die Oberflaeche erreichbar
# ist. Leer lassen heisst: nur ueber Loopback.
UI_TAILSCALE_IP=100.67.177.45

# Adresse, unter der DIESER Laden im Browser aufgerufen wird — die
# `tailscale serve`-Adresse mit SEINEM Port (RUNBOOK, Abschnitt "Einen
# zweiten Laden anlegen" -> "Zugang: eigener Serve-Port"). Unterscheidet
# sich von Laden zu Laden: der bestehende Laden haengt an Port 443 (in
# der URL weggelassen), ein weiterer Laden an seinem eigenen, hier
# beispielhaft :8444. Bleibt die Zeile leer, faellt ui.py still auf
# http://127.0.0.1:8791 zurueck (docker-compose.yml, Dienst sales-ui) —
# das ist der Loopback-Port des BESTEHENDEN Ladens. Die
# Passwort-vergessen-Mail ginge dann trotzdem raus, nur zeigte der Link
# darin ins Nichts des Containers statt auf die eigene Oberflaeche.
UI_BASIS_URL=https://vibemind-offload-1.tail6c7d61.ts.net:8444

# Bot-Token vom BotFather (@BotFather in Telegram, /newbot fuer einen
# neuen Bot bzw. /token fuer einen bestehenden). Wird NIE ueber argv
# uebergeben, immer ueber die Umgebung/stdin (docs/11_INBETRIEBNAHME.md,
# Abschnitt "Ein Wert geht nie ueber argv") — argv stuende in der
# Prozessliste des Hosts, sichtbar fuer jeden mit Zugriff auf die
# Maschine. Vor dem Einspielen die Laenge nachmessen (`printf '%s'
# "$TOKEN" | wc -c`, ueblich 46 Zeichen) — ein mitkopiertes Zeilenende
# hat schon einmal einen Token unbrauchbar gemacht (12.09.2026).
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------
# Ab hier: Werte, die die Schlusspruefung vom 16.09.2026 (Bereich C, W8)
# in dieser Vorlage vermisst hat. Jede hat in docker-compose.yml ein
# `${VAR:-}`-Rueckfallmuster (siehe dort, Anker x-sales-mcp-umgebung und
# die Dienste sales-ui/sales-mail/sales-telegram/sales-linkedin) — eine
# fehlende Zeile hier loest deshalb still zu LEER auf, nie zu einem
# Fehler beim Start. Nachgemessen gegen den TATSAECHLICHEN Stand von
# docker-compose.yml nach Commit f4189c4 (der Umbau von `env_file: .env`
# auf den Anker hat sechs weitere Werte fuer sales-mcp/-dispatch/-inbox/
# -auto erst sichtbar/laden-scharf gemacht: ANTHROPIC_API_KEY,
# ROWBOAT_URL/-PROJECT_ID/-API_KEY, GOOGLE_MEET_*, APIFY_TOKEN,
# RECHERCHE_LEAD_ID, LINKEDIN_POST_LEAD_ID — die urspruengliche
# Schlusspruefung liegt VOR diesem Commit und kannte sie noch nicht).
# ---------------------------------------------------------------------

# Mail (docs/11_INBETRIEBNAHME.md, Abschnitt 9: Postfach `<name>@vibemind.
# space` beim Anbieter anlegen). SMTP_USER und EMAIL_ABSENDER MUESSEN auf
# dasselbe Postfach zeigen (docs/11, Abschnitt 2.3) — sonst treffen
# Antworten im falschen Postfach ein, ohne jede Fehlermeldung; genau das
# prueft deploy/smoke.sh, Abschnitt "Absenderadressen sind je Laden
# verschieden". Bleiben alle vier leer, meldet sales-mail das beim Start
# als "E-Mail-Kanal nicht eingerichtet" und beendet sich sauber mit
# Exit 0 (kein Fehler-Container, mail_dispatch.py:668) — der Kanal ist
# dann gebaut, aber inert: freigegebene E-Mail-Entwuerfe bleiben liegen,
# bis die Werte eingetragen werden. Ist nur EMAIL_ABSENDER gesetzt, aber
# keine brauchbare Adresse, beendet sich der Dienst ebenso sauber, nur
# mit einer anderen Logzeile.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORT=
EMAIL_ABSENDER=

# LinkedIn (eigener Zugang des neuen Menschen, docs/11 Abschnitt 9: die
# Anmeldung im Container muss das EIGENE Profil zeigen, nicht das des
# bestehenden Ladens). Beide Werte fehlen praktisch immer zusammen — ohne
# sie meldet linkedin_api.fehlende_konfiguration() beide als fehlend, und
# sales-linkedin veroeffentlicht nichts (kein Fehler-Exit, schlicht
# wirkungslos bis zum Eintragen).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# openwa-API-Zugang (WhatsApp-VERSAND/-STATUS) — NICHT dasselbe wie das
# WhatsApp-PAIRING selbst: das braucht laut docs/11 Abschnitt 9 bewusst
# KEINEN Eintrag hier, es liegt im eigenen Volume `<name>-claw-state`.
# OPENWA_API_KEY erzeugt openwa beim ALLERERSTEN Start dieses Ladens
# selbststaendig und schreibt ihn einmalig ins Startlog
# (`docker logs <name>-openwa`) — von dort abschreiben, nicht selbst
# ausdenken. OPENWA_SESSION_ID ist der beim Pairing vergebene
# Sitzungsname. Fehlt eines von beiden, verweigert sales-dispatch den
# Start ("Konfiguration unvollstaendig ... es wird nichts versendet",
# Exit 2, dispatch.py) — der WhatsApp-Versandkanal ist dann sichtbar tot
# (Container in Neustart-Schleife), nicht still. OPENWA_VIEWER_KEY ist
# ein separater, NUR LESENDER Schluessel fuer die /whatsapp-Statusseite
# der Oberflaeche; fehlt er, zeigt die Seite lediglich eine Erklaerung
# statt eines Fehlers — optional, ohne Wirkung auf den Versand.
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_VIEWER_KEY=

# Eingehender Webhook von openwa (Kundenantworten, Sprachnachrichten).
# INBOX_WEBHOOK_SECRET signiert jede eingehende Anfrage (HMAC-SHA256,
# mindestens 16 Zeichen, inbox.py:SECRET_MIN) — OHNE dieses Geheimnis
# startet sales-inbox GAR NICHT (verweigert den Start beim Boot, keine
# stille Degradation): der gesamte Eingang dieses Ladens steht dann.
# INBOX_UNBEKANNT_LEAD_ID ist die lead_id des Sammelkontakts fuer
# unbekannte Absender; bleibt sie leer, findet server._einzuordnende()
# nichts und die Seite /einordnung bleibt dauerhaft leer, OHNE dass
# irgendwo ein Fehler erscheint — bewusst getrennt vom Secret oben
# genannt, weil sich die beiden ganz unterschiedlich verhalten (laut vs.
# still).
INBOX_WEBHOOK_SECRET=
INBOX_UNBEKANNT_LEAD_ID=

# Anmeldung der Oberflaeche (E1) — SICHERHEITSKRITISCH, siehe W7 der
# Korrekturwelle vom 16.09.2026 (Bereich C). LEER heisst: die Oberflaeche
# laeuft im Uebergangszustand OHNE Anmeldepflicht — die Tailscale-Bindung
# waere dann die EINZIGE Tuer, und weder ui.py noch dieser Laden meldet
# das von sich aus (kein Log, kein Fehler — die Seite laedt einfach ohne
# /login). deploy/smoke.sh, Abschnitt "UI_SESSION_SECRET je laufender
# Oberflaeche", meldet einen leeren Wert deshalb ROT, sobald `<name>-ui`
# laeuft. Wird NICHT hier von Hand eingetragen: `deploy/benutzer-anlegen.
# sh <name>` erzeugt ihn beim allerersten Benutzer dieses Ladens
# automatisch und schreibt ihn in genau diese Zeile dieser Datei — die
# leere Zeile hier ist Absicht (ein Geheimnis gehoert nicht in eine
# Kopiervorlage).
UI_SESSION_SECRET=

# Erlaubter Host-Header fuer die tailscale-serve-Adresse dieses Ladens
# (Gegenstueck zu UI_TAILSCALE_IP oben, siehe UI_EXTRA_HOSTS in
# docker-compose.yml, Dienst sales-ui) — derselbe Rechnername wie im
# UI_BASIS_URL-Wert oben, OHNE `https://` und OHNE Port. Bleibt die Zeile
# leer, akzeptiert die Oberflaeche nur noch die Tailscale-IP als
# zusaetzlichen Host: ein Aufruf genau ueber die in UI_BASIS_URL/der
# Passwort-vergessen-Mail genannte Adresse scheitert dann am
# Host-Check, obwohl der Link korrekt aussieht.
UI_SERVE_HOST=vibemind-offload-1.tail6c7d61.ts.net

# Kalender (rein lesend, /kalender-Tab, CalDAV REPORT — kein PUT). Ohne
# CALDAV_URL/-USER/-PASSWORT bleibt der Tab ohne Termine, ohne
# Fehlermeldung (kalender.py liest alle drei nur zur Aufrufzeit) —
# optional, betrifft ausschliesslich diese eine Ansicht.
CALDAV_URL=
CALDAV_USER=
CALDAV_PASSWORT=

# Weitere optionale Integrationen. Jede degradiert fuer sich allein, ohne
# den restlichen Laden zu beeinflussen, solange sie leer bleibt:
#   ANTHROPIC_API_KEY   Modellzugang fuer sales-auto (automatische
#                        Kundenantworten). Leer: sales-auto verweigert
#                        den Start (Exit 2, auto.py) — unschaedlich, der
#                        Dienst laeuft ohnehin nie von selbst mit
#                        (restart: "no", muss von Hand gestartet werden).
#   ROWBOAT_URL / ROWBOAT_PROJECT_ID / ROWBOAT_API_KEY
#                        Wissensdatenbank-Anbindung fuer Chat-Antworten.
#                        Fehlt eines, meldet
#                        rowboat.fehlende_konfiguration() es, und die
#                        Werkzeuge, die dort nachschlagen, antworten
#                        schlicht "nicht eingerichtet" statt zu scheitern.
#   GOOGLE_MEET_CLIENT_ID / GOOGLE_MEET_CLIENT_SECRET /
#   GOOGLE_MEET_REFRESH_TOKEN
#                        Google-Meet-Konferenzen. Leer: konferenz.py
#                        faellt still auf Jitsi zurueck
#                        (KONFERENZ_ANBIETER) — kein Fehler, nur ein
#                        anderer Anbieter als vielleicht erwartet.
#   APIFY_TOKEN          Lead-Recherche/-Anreicherung. Leer: die
#                        Recherche-Werkzeuge liefern keine Daten, statt
#                        zu scheitern.
#   RECHERCHE_LEAD_ID / LINKEDIN_POST_LEAD_ID
#                        Sammel-Leads fuer sales-auto (Recherche- bzw.
#                        LinkedIn-Vorschlaege aus Kundenantworten). Leer:
#                        dieser Teil von sales-auto tut fuer diesen Laden
#                        einfach nichts — wie ANTHROPIC_API_KEY betrifft
#                        das ausschliesslich den optionalen Auto-Betrieb.
ANTHROPIC_API_KEY=
ROWBOAT_URL=
ROWBOAT_PROJECT_ID=
ROWBOAT_API_KEY=
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
APIFY_TOKEN=
RECHERCHE_LEAD_ID=
LINKEDIN_POST_LEAD_ID=
# Medien je Laden (23.09.2026, Betreiber: fuer mich meine Medien, fuer Ivan
# andere). Ohne diese zwei Zeilen haengt docker-compose.yml die Ordner des
# Basis-Ladens ein; deploy/update.sh weist einen Laden ohne sie deshalb ab.
MEDIEN_ORDNER=./laeden-daten/beispiel/media
MEDIEN_ERZEUGT_ORDNER=./laeden-daten/beispiel/media-erzeugt
MITGLIED_NAME=Vorname Nachname
